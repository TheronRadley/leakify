{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": [
      "jest",
      "node"
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "nativewind-env.d.ts"
  ],
  // supabase/functions/* are Deno Edge Functions (Deno globals, https://
  // imports) — not part of the app's TS program.
  "exclude": [
    "node_modules",
    "supabase/functions"
  ]
}
